{
  "manifest_version": 2,
  "name": "PhishGuard — automatic URL guard",
  "short_name": "PhishGuard",
  "version": "1.1.10",
  "author": "Noah Otim <otim.no25@gmail.com>",
  "description": "Automatically checks every site you open against your PhishGuard server and blocks phishing, malware, gambling, adult and social-media pages with a warning interstitial.",
  "permissions": [
    "webNavigation",
    "storage",
    "alarms",
    "tabs",
    "<all_urls>",
    "notifications"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_title": "PhishGuard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://dressing-duck-dose-controllers.trycloudflare.com/*",
        "http://192.168.100.43:8000/*"
      ],
      "js": ["content-install-detect.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content-youtube.js"],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "phishguard-guard@phishguard.local",
      "strict_min_version": "109.0",
      "update_url": "https://versioncheck.addons.mozilla.org/update/VersionCheck.php?reqVersion=%REQ_VERSION%&id=%ITEM_ID%&version=%ITEM_VERSION%&appID=%APP_ID%&appVersion=%APP_VERSION%"
    }
  }
}
