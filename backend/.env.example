# ---- environment -------------------------------------------------
APP_ENV=development
APP_DEBUG=true

# ---- database ----
# Absolute or relative path (relative to backend/)
DATABASE_PATH=data/antiphishing.db
SEED_ON_STARTUP=true

# ---- auth ----
TOKEN_TTL_HOURS=168
PBKDF2_ROUNDS=310000
DEFAULT_ADMIN_EMAIL=admin@company-example.com
# Only used at first run (fresh DB). Change immediately after login.
DEFAULT_ADMIN_PASSWORD=ChangeMe_123!

# ---- rate limiting ----
RATE_LIMIT_ENABLED=true
ANALYZE_RATE_LIMIT=30/minute
GENERIC_RATE_LIMIT=120/minute
AUTH_RATE_LIMIT=10/minute

# ---- risk thresholds ----
LOW_RISK_THRESHOLD=20
MODERATE_RISK_THRESHOLD=50
HIGH_RISK_THRESHOLD=75

# ---- threat intelligence (external providers are OFF by default) ----
# Set ENABLE_EXTERNAL_TI to true ONLY if you configure at least one API key.
# The keyless URLhaus live feed is controlled by TI_SYNC_* below.
ENABLE_EXTERNAL_TI=false
TI_FETCH_TIMEOUT_S=5
VIRUSTOTAL_API_KEY=
GOOGLE_SAFEBROWSING_API_KEY=
GOOGLE_SAFEBROWSING_CLIENT_ID=antiphishing-platform
URLHAUS_BASE_URL=https://urlhaus-api.abuse.ch/v1

# ---- live threat-intel feed (keyless abuse.ch URLhaus hostfile) ----
# Pulls fresh malicious hosts into known_threats on a schedule so every
# scan checks against real, recently-active phishing infrastructure.
TI_SYNC_ENABLED=true
TI_SYNC_INTERVAL_MIN=30
TI_SYNC_MAX_ITEMS=5000
TI_SYNC_MAX_TOTAL=100000

# ---- server ----
HOST=0.0.0.0
PORT=8000